import agenciaDeViajes.*

describe "Parte 1" {
  test "Un pack nacional sin beneficios vigentes devuelve el mismo precio base." {
    const nacional = new Packs(precioBase= 10, coordinadorACargo = guia)

    assert.equals(10, nacional.valorFinal())
  }
  test "Un pack nacional con 2 beneficios vigentes suma correctamente sus costos al precio base."{
    const nacional = new Packs(precioBase= 10, coordinadorACargo = guia)
    nacional.agregarBeneficio(trasladosPrivados)
    nacional.agregarBeneficio(accesoSalasVip)

    assert.equals(30, nacional.valorFinal())
  }
  test "Un pack internacional sin beneficios vigentes calcula correctamente el total con el 20% de recargo."{
    const internacional = new Internacionales(precioBase= 10, coordinadorACargo = guia, paisDestino = "Argentina")
    

    assert.equals(12, internacional.valorFinal())
  }
}

describe "Parte 2" {
  test "Un guía motivado con 21 viajes realizados es considerado altamente calificado." {
    const guia = new Coordinador ()
    guia.cambiarCantDeViajesRealizados(21)
    guia.motivar()

    assert.that(guia.estaAltamenteCalificado())
  }
  test "Un asistente logístico con menos de 3 años de experiencia no es calificado, aunque tenga muchos viajes." {
    const asistenteLogistico1 = new Coordinador ()
    agencia.cambiarRolAlCoordinador(asistenteLogistico1, asistenteLogistico)
    asistenteLogistico1.cambiarCantDeViajesRealizados(21)
    asistenteLogistico1.aumentarAnioDeExperiencia()
    


    assert.notThat(asistenteLogistico1.estaAltamenteCalificado())
  }

  test "Un acompañante con cualquier cantidad de viajes es siempre calificado si supera los 20." {
    const unAcompaniante = new Coordinador ()
    agencia.cambiarRolAlCoordinador(unAcompaniante, acompaniante)
    unAcompaniante.cambiarCantDeViajesRealizados(21)

    assert.that(unAcompaniante.estaAltamenteCalificado())
  }
}