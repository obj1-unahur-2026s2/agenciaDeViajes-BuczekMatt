import agenciaDeViajes.*

describe "Parte 1" {
  test "Un pack nacional sin beneficios vigentes devuelve el mismo precio base." {
    const coordinador = new Coordinador()
    agencia.cambiarRolAlCoordinador(coordinador, guia)
    const nacional = new Nacionales (precioBase= 10, provDestino="Rio Negro", coordinadorACargo = coordinador)
    
    assert.equals(10, nacional.valorFinal())
  }
  test "Un pack nacional con 2 beneficios vigentes suma correctamente sus costos al precio base."{
    const coordinador = new Coordinador()
    agencia.cambiarRolAlCoordinador(coordinador, guia)

    const nacional = new Nacionales (precioBase= 10, provDestino="Rio Negro", coordinadorACargo = coordinador)
    nacional.agregarBeneficio(trasladosPrivados)
    nacional.agregarBeneficio(accesoSalasVip)

    assert.equals(30, nacional.valorFinal())
  }
  test "Un pack internacional sin beneficios vigentes calcula correctamente el total con el 20% de recargo."{
    const coordinador = new Coordinador()
    agencia.cambiarRolAlCoordinador(coordinador, guia)

    const internacional = new Internacionales(precioBase= 10, coordinadorACargo = coordinador, paisDestino = "EEUU")
    

    assert.equals(12, internacional.valorFinal())
  }
}

describe "Parte 2" {
  test "Un guía motivado con 21 viajes realizados es considerado altamente calificado." {
    const guia = new Coordinador ()
    guia.cambiarCantDeViajesRealizados(21)
    guia.motivar()

    assert.that(guia.estaAltamenteCalificado())
  }
  test "Un asistente logístico con menos de 3 años de experiencia no es calificado, aunque tenga muchos viajes." {
    const asistenteLogistico1 = new Coordinador ()
    agencia.cambiarRolAlCoordinador(asistenteLogistico1, asistenteLogistico)
    asistenteLogistico1.cambiarCantDeViajesRealizados(21)
    asistenteLogistico1.aumentarAnioDeExperiencia()
    


    assert.notThat(asistenteLogistico1.estaAltamenteCalificado())
  }

  test "Un acompañante con cualquier cantidad de viajes es siempre calificado si supera los 20." {
    const unAcompaniante = new Coordinador ()
    agencia.cambiarRolAlCoordinador(unAcompaniante, acompaniante)
    unAcompaniante.cambiarCantDeViajesRealizados(21)

    assert.that(unAcompaniante.estaAltamenteCalificado())
  }
}

describe "Parte 3" {
  test "pack premium nacional, 10 dia de duracion, coordinador altamente calificado" {
    const guia = new Coordinador ()
    guia.cambiarCantDeViajesRealizados(21)
    guia.motivar()
    
    const nacional = new Nacionales(precioBase= 10, provDestino="Rio Negro", coordinadorACargo = guia)
    nacional.cambiarDuracionDeDias(14)
    

    assert.that(nacional.esPremium())
  }
  test "pack premium internacional, es lugar de interes, tiene mas de 20 dias de duracion, sin escalas" {
    const coordinador = new Coordinador()
    agencia.cambiarRolAlCoordinador(coordinador, guia)


    const internacional = new Internacionales(precioBase= 10, coordinadorACargo = coordinador, paisDestino = "EEUU")
    internacional.ponerComoLugarDeInteres()
    internacional.cambiarDuracionDeDias(21)
    internacional.cambiarCantEscalas(0)


    assert.that(internacional.esPremium())
  }
}

describe "Parte 4" {
  test "pack premium provinciales, 4 actividades, 5 ciudades para visitar con 3 beneficios vigentes " {
    const coordinador = new Coordinador()
    agencia.cambiarRolAlCoordinador(coordinador, guia)

    const provinciales = new Provinciales (precioBase= 10, provDestino="Rio Negro", coordinadorACargo = coordinador)
    provinciales.agregarActividad("Sky")
    provinciales.agregarActividad("Visitar Centro")
    provinciales.agregarActividad("Visitar Lagos")
    provinciales.agregarActividad("Tomar Chocolate Caliente")
    provinciales.cambiarCantDeCiudadesAVisitar(5)
    provinciales.agregarBeneficio(trasladosPrivados)
    provinciales.agregarBeneficio(accesoSalasVip)
    provinciales.agregarBeneficio(segurosAdicionales)

    assert.that(provinciales.esPremium())
  }
  test "pack premium provinciales 5% mas caros" {
    const coordinador = new Coordinador()
    agencia.cambiarRolAlCoordinador(coordinador, guia)
    
    const provinciales = new Provinciales (precioBase= 10, provDestino="Rio Negro", coordinadorACargo = coordinador)
    provinciales.agregarActividad("Sky")
    provinciales.agregarActividad("Visitar Centro")
    provinciales.agregarActividad("Visitar Lagos")
    provinciales.agregarActividad("Tomar Chocolate Caliente")
    provinciales.cambiarCantDeCiudadesAVisitar(5)
    provinciales.agregarBeneficio(trasladosPrivados)
    provinciales.agregarBeneficio(accesoSalasVip)
    provinciales.agregarBeneficio(segurosAdicionales)

    assert.equals(42, provinciales.valorFinal())
  }
}